if [[ -d /lfs ]]
then
	LFS_HOME="/lfs/local/0/$USER"
	if [[ -f $LFS_HOME/setup-node.sh ]]
	then
		bash "$LFS_HOME/setup-node.sh" || echo "WARNING: setup-node.sh failed" >&2
	else
		echo "setting up $LFS_HOME"
		curl -fsSL https://raw.githubusercontent.com/VedangAsgaonkar/dotfiles/main/setup-node.sh | bash
	fi
	if [[ -d $LFS_HOME ]]
	then
		export HOME="$LFS_HOME"
	fi
	[[ $- == *i* ]] && echo HOME="$HOME"
	cd
fi

# PATH and pixi for every shell, interactive or not: `ssh <host> cmd` runs this
# far and needs the same tools a login does (pixi, ~/.local/bin, and on Marlowe
# slurm, which the system PATH lacks). fish inherits all of it.
export PIXI_HOME="$HOME/.pixi"
export PATH="$PIXI_HOME/envs/nodejs/bin/:$HOME/.local/bin:$PIXI_HOME/bin:$PATH"

[[ $- != *i* ]] && return

FISH_SHELL="$PIXI_HOME/bin/fish"
if [[ -x $FISH_SHELL ]]
then
	export SHELL="$FISH_SHELL"
fi
echo SHELL="$SHELL"
exec $SHELL
