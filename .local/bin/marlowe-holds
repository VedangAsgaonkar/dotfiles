#!/usr/bin/env python3
import argparse
import curses
import json
import os
import subprocess
import sys
import time
from datetime import datetime

KIND_NAMES = ("1gpu", "8gpu", "batch8")
KINDS = ",".join(f"hold-pool-{k}" for k in KIND_NAMES)
REMOTE = f"""
echo '#T'; date +%s
echo '#Q'; squeue -h -u $USER -n {KINDS} -o '%i|%j|%T|%M|%L|%l|%N|%r|%S|%V|%b|%P|%a'
echo '#S'; squeue -h -s -u $USER -o '%i|%j|%M'
echo '#C'; ls ~/scratch/marlowe-pool/claims 2>/dev/null
echo '#E'; ids=$(squeue -h -u $USER -n {KINDS} -t R -o %i | paste -sd,); [ -n "$ids" ] && sacct -n -P -j "$ids" -o JobID,End
echo '#I'; for id in $(squeue -h -u $USER -n {KINDS} -t R -o %i); do s=$(scontrol write batch_script $id - 2>/dev/null); echo "$id|$(grep -o -E 'last >= [0-9]+' <<< "$s" | grep -o -E '[0-9]+$')|$(grep -q -E 'trap .* USR2' <<< "$s" && echo y)|$(cat ~/scratch/marlowe-pool/logs/hold_pool-*_$id.out 2>/dev/null | grep -o -E 'USR2 at [0-9:]+' | tail -1 | cut -d' ' -f3)"; done
echo '#L'; tail -2 ~/scratch/marlowe-pool/cron.log 2>/dev/null
true
"""


def run_remote() -> str:
    if os.path.isdir("/marlowe"):
        cmd = ["bash", "-c", REMOTE]
    else:
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "marlowe", REMOTE]
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if out.returncode == 255:
        raise RuntimeError(out.stderr.strip().splitlines()[-1] if out.stderr.strip() else "ssh failed")
    return out.stdout


def secs(t: str) -> int | None:
    if not t or t in ("INVALID", "UNLIMITED", "NOT_SET", "N/A"):
        return None
    d = 0
    if "-" in t:
        d, t = t.split("-")
    parts = [int(x) for x in t.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(d) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def epoch(t: str) -> int | None:
    if not t or t in ("N/A", "Unknown", "None"):
        return None
    return int(datetime.fromisoformat(t).timestamp())


def collect(kind: str | None = None) -> dict:
    sections, cur = {}, None
    for line in run_remote().splitlines():
        if line.startswith("#") and len(line) == 2:
            cur = line[1]
            sections[cur] = []
        elif cur and line.strip():
            sections[cur].append(line)
    now = int(sections.get("T", [str(int(time.time()))])[0])
    steps, ends = {}, {}
    for line in sections.get("S", []):
        sid, name, _ = line.split("|")
        job, _, step = sid.partition(".")
        if step.isdigit():
            steps.setdefault(job, []).append(name)
    for line in sections.get("E", []):
        sid, end = line.split("|")
        job, _, step = sid.partition(".")
        if step.isdigit() and epoch(end):
            ends[job] = max(ends.get(job, 0), epoch(end))
    claims = set(sections.get("C", []))
    limits, ext, usr2 = {}, set(), {}
    for line in sections.get("I", []):
        i, s, u, r = (line.split("|") + ["", "", ""])[:4]
        if s.isdigit():
            limits[i] = int(s)
        if u == "y":
            ext.add(i)
        if r:
            at = datetime.combine(datetime.fromtimestamp(now).date(), datetime.strptime(r, "%H:%M:%S").time())
            usr2[i] = int(at.timestamp()) - (86400 if at.timestamp() > now else 0)
    holds = []
    for line in sections.get("Q", []):
        jid, name, state, elapsed, left, limit, node, reason, start, submit, tres, part, acct = line.split("|")
        gpus = int(tres.rsplit(":", 1)[-1]) if "gpu" in tres else 0
        h = dict(id=jid, kind=name.removeprefix("hold-pool-"), gpus=gpus, partition=part, account=acct,
                 state=state, node=node or None, limit=limit, elapsed_s=secs(elapsed), left_s=secs(left),
                 submitted=submit, waited_s=now - epoch(submit) if epoch(submit) else None, reason=reason,
                 est_start=start if state == "PENDING" and start != "N/A" else None,
                 steps=steps.get(jid, []), claimed=jid in claims, idle_s=None, idle_limit_s=limits.get(jid),
                 extendable=jid in ext, last_extended=datetime.fromtimestamp(usr2[jid]).isoformat() if jid in usr2 else None)
        if state == "RUNNING" and not h["steps"]:
            since = max(epoch(start) or now, ends.get(jid, 0), usr2.get(jid, 0))
            h["idle_s"] = now - since
        if kind is None or h["kind"] == kind:
            holds.append(h)
    holds.sort(key=lambda h: (h["state"] != "RUNNING", h["kind"], -(h["left_s"] or 0), h["submitted"]))
    return dict(now=now, holds=holds, cron=sections.get("L", []))


def hm(s: int | None) -> str:
    if s is None:
        return "-"
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def work(h: dict) -> str:
    if h["state"] != "RUNNING":
        return "-"
    if h["steps"]:
        return "busy: " + ",".join(sorted(set(h["steps"])))
    tag = "claimed, " if h["claimed"] else ""
    left = f" (exits ~{hm(max(0, h['idle_limit_s'] - (h['idle_s'] or 0)))})" if h["idle_limit_s"] else ""
    ext = ", USR2 extends" if h["extendable"] else ""
    return f"{tag}idle {hm(h['idle_s'])}{left}{ext}"


COLS = [("ID", 8), ("KIND", 6), ("GPU", 3), ("PART", 7), ("STATE", 8), ("NODE", 5), ("RUN", 7), ("WALL LEFT", 9), ("WAITED", 7), ("EST START", 16), ("WORK / REASON", 40)]


def rows(data: dict) -> list[tuple[str, list[str]]]:
    out = []
    for h in data["holds"]:
        detail = work(h) if h["state"] == "RUNNING" else h["reason"]
        est = h["est_start"][5:16].replace("T", " ") if h["est_start"] else "-"
        running = h["state"] == "RUNNING"
        cells = [h["id"], h["kind"], str(h["gpus"]), h["partition"], h["state"][:8], h["node"] or "-",
                 hm(h["elapsed_s"]) if running else "-", hm(h["left_s"]) if running else "-",
                 hm(h["waited_s"]) if h["state"] == "PENDING" else "-", est, detail]
        tone = "busy" if h["steps"] else "idle" if running else "wait"
        out.append((tone, cells))
    return out


def summary(data: dict, kind: str | None) -> list[str]:
    lines = []
    for k in (kind,) if kind else KIND_NAMES:
        hs = [h for h in data["holds"] if h["kind"] == k]
        run = [h for h in hs if h["state"] == "RUNNING"]
        busy = sum(1 for h in run if h["steps"])
        ests = sorted(h["est_start"] for h in hs if h["est_start"])
        nxt = f", next est. start {ests[0][5:16].replace('T', ' ')}" if ests and not run else ""
        lines.append(f"{k}: {len(run)} running ({busy} busy, {len(run) - busy} idle), {len(hs) - len(run)} queued{nxt}")
    return lines


def fmt(cells: list[str]) -> str:
    return "  ".join(c.ljust(w) if i < len(COLS) - 1 else c for i, (c, (_, w)) in enumerate(zip(cells, COLS)))


def plain(data: dict, kind: str | None) -> str:
    out = [datetime.fromtimestamp(data["now"]).strftime("%Y-%m-%d %H:%M:%S") + " Marlowe hold pool", *summary(data, kind)]
    out.append(fmt([c for c, _ in COLS]))
    out += [fmt(cells) for _, cells in rows(data)]
    if data["cron"]:
        out.append("last cron: " + data["cron"][-1])
    return "\n".join(out)


def helper(name: str, jid: str) -> str:
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    out = subprocess.run([path, jid], capture_output=True, text=True, timeout=60)
    return (out.stdout.strip() or out.stderr.strip() or f"{name} exited {out.returncode}").splitlines()[-1]


SHORT = {"1gpu": "1g", "8gpu": "8g", "batch8": "b8"}


def tiny_header(data: dict, kind: str | None) -> str:
    parts = []
    for k in (kind,) if kind else KIND_NAMES:
        hs = [h for h in data["holds"] if h["kind"] == k]
        run = [h for h in hs if h["state"] == "RUNNING"]
        busy = sum(1 for h in run if h["steps"])
        ests = sorted(h["est_start"] for h in hs if h["est_start"])
        eta = f"~{ests[0][11:16]}" if ests and not run else ""
        parts.append(f"{SHORT[k]} {busy}/{len(run) - busy} {len(hs) - len(run)}q{eta}")
    return datetime.fromtimestamp(data["now"]).strftime("%H:%M") + " " + " ".join(parts)


def tiny_row(h: dict) -> str:
    if h["steps"]:
        what = "busy " + ",".join(sorted(set(h["steps"])))
    else:
        rel = f">{hm(max(0, h['idle_limit_s'] - (h['idle_s'] or 0)))}" if h["idle_limit_s"] else ""
        what = f"idle {hm(h['idle_s'])} {rel}{' E' if h['extendable'] else ''}{' C' if h['claimed'] else ''}"
    return f"{h['id']} {SHORT[h['kind']]} {h['node'] or '-':4} {what}"


def tui(stdscr, every: int, kind: str | None, tiny: bool = False) -> None:
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    tone = {"busy": curses.color_pair(1), "idle": curses.color_pair(2), "wait": curses.color_pair(3)}
    stdscr.timeout(1000)
    data, err, last, sel, msg, confirm, top, page = None, None, 0.0, 0, "", None, 0, 1
    while True:
        if time.time() - last >= every:
            try:
                data, err = collect(kind), None
            except Exception as e:
                err = str(e)
            last = time.time()
        holds = data["holds"] if data else []
        if tiny:
            holds = [hd for hd in holds if hd["state"] == "RUNNING"]
        sel = max(0, min(sel, len(holds) - 1))
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        put = lambda y, s, a=0: y < h and stdscr.addnstr(y, 0, s, w - 1, a)
        y = 0
        if data and tiny:
            put(y, tiny_header(data, kind), curses.A_BOLD); y += 1
            page = max(1, h - y - 1)
            top = min(max(top, sel - page + 1), sel) if holds else 0
            for i, hd in enumerate(holds[top:top + page], start=top):
                t = "busy" if hd["steps"] else "idle"
                put(y, tiny_row(hd), tone[t] | (curses.A_REVERSE if i == sel else 0)); y += 1
            if not holds:
                put(y, "no hold running"); y += 1
        elif data:
            put(y, datetime.fromtimestamp(data["now"]).strftime("%H:%M:%S") + f"  Marlowe hold pool  (refresh {every}s)  up/down: select  e: extend (USR2)  t: terminate  r: refresh  q: quit", curses.A_BOLD); y += 1
            for line in summary(data, kind):
                put(y, line); y += 1
            put(y, fmt([c for c, _ in COLS]), curses.A_UNDERLINE); y += 1
            page = max(1, h - y - (3 if data["cron"] else 1))
            top = min(max(top, sel - page + 1), sel) if holds else 0
            for i, (t, cells) in list(enumerate(rows(data)))[top:top + page]:
                put(y, fmt(cells), tone[t] | (curses.A_REVERSE if i == sel else 0)); y += 1
            if data["cron"]:
                y += 1
                put(y, "last cron: " + data["cron"][-1]); y += 1
        if err:
            y += 1
            put(y, "error: " + err, curses.A_BOLD); y += 1
        if confirm:
            put(h - 1, f"terminate {confirm[0]}? y/N" if tiny else confirm[1], curses.A_BOLD)
        elif msg:
            put(h - 1, msg)
        elif tiny:
            put(h - 1, f"[{sel + 1}/{len(holds)}] jk e t r q" if holds else "r q", curses.A_DIM)
        elif holds:
            put(h - 1, f"[{sel + 1}/{len(holds)}]  PgUp/PgDn: page  Home/End (g/G): first/last", curses.A_DIM)
        stdscr.refresh()
        k = stdscr.getch()
        if confirm:
            if k == ord("y"):
                msg = helper("marlowe-hold-release", confirm[0])
                last = 0.0
            elif k != -1:
                msg = "terminate: cancelled"
            if k != -1:
                confirm = None
            continue
        if k in (ord("q"), 27):
            return
        if k == ord("r"):
            last = 0.0
        elif k in (curses.KEY_DOWN, ord("j")):
            sel += 1
        elif k in (curses.KEY_UP, ord("k")):
            sel -= 1
        elif k == curses.KEY_NPAGE:
            sel += page
        elif k == curses.KEY_PPAGE:
            sel -= page
        elif k in (curses.KEY_HOME, ord("g")):
            sel = 0
        elif k in (curses.KEY_END, ord("G")):
            sel = len(holds) - 1
        elif k == ord("e") and holds:
            hd = holds[sel]
            if hd["state"] != "RUNNING":
                msg = f"{hd['id']}: not running, nothing to extend"
            elif not hd["extendable"]:
                msg = f"{hd['id']}: submitted before holds handled USR2; not extending (USR2 would end it)"
            else:
                msg = helper("marlowe-hold-extend", hd["id"])
                last = 0.0
        elif k == ord("t") and holds:
            hd = holds[sel]
            what = ("TERM to the hold: it releases once no job is running in it" if hd["state"] == "RUNNING"
                    else f"cancel the {hd['state'].lower()} hold")
            confirm = (hd["id"], f"terminate {hd['id']} ({hd['kind']}): {what}? [y/N]")


def main() -> None:
    p = argparse.ArgumentParser(description="Marlowe hold pool: queued and running holds")
    p.add_argument("--json", action="store_true", help="one snapshot as JSON")
    p.add_argument("--plain", action="store_true", help="one snapshot as a table")
    p.add_argument("--kind", choices=KIND_NAMES, help="only this kind of hold")
    p.add_argument("--every", type=int, default=15, help="seconds between refreshes in the live view")
    p.add_argument("--tiny", action="store_true", help="live view small enough for a floating tmux pane")
    a = p.parse_args()
    if a.json:
        print(json.dumps(collect(a.kind), indent=1))
    elif a.plain or not sys.stdout.isatty():
        print(plain(collect(a.kind), a.kind))
    else:
        try:
            curses.wrapper(tui, a.every, a.kind, a.tiny)
        except KeyboardInterrupt:
            pass


main()
