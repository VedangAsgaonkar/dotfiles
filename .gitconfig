	email = vedanga2015@gmail.com
[push]
	autoSetupRemote = True
[credential "https://github.com"]
	helper = !~/.pixi/envs/gh/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !~/.pixi/envs/gh/bin/gh auth git-credential
[pull]
	rebase = false
[init]
	defaultBranch = main
[fetch]
	prune = true
